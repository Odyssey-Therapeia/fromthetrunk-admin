# ──────────────────────────────────────────────────────────────
# From the Trunk — Production Environment Variables
# Copy this file, fill in all values, and set in your deployment platform.
# ──────────────────────────────────────────────────────────────

# ─── Database ─────────────────────────────────────────────────
# PostgreSQL connection string (e.g., Neon, Supabase, Railway)
DATABASE_URL=postgres://user:password@host/database?sslmode=require

# ─── Application ──────────────────────────────────────────────
NEXT_PUBLIC_SERVER_URL=https://yourdomain.com

# ─── Auth (NextAuth) ─────────────────────────────────────────
NEXTAUTH_URL=https://yourdomain.com
NEXTAUTH_SECRET=generate-a-random-32-char-string

# ─── OAuth Providers ─────────────────────────────────────────
# At least one provider must be configured for sign-in to work.

# Google OAuth
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Azure AD (optional)
AZURE_AD_CLIENT_ID=
AZURE_AD_CLIENT_SECRET=
AZURE_AD_TENANT_ID=common

# Twitter/X (optional)
TWITTER_CLIENT_ID=
TWITTER_CLIENT_SECRET=

# ─── Razorpay Payment Gateway ────────────────────────────────
RAZORPAY_KEY_ID=rzp_live_xxxxx
RAZORPAY_KEY_SECRET=your-razorpay-key-secret
RAZORPAY_WEBHOOK_SECRET=your-webhook-secret
NEXT_PUBLIC_RAZORPAY_KEY_ID=rzp_live_xxxxx

# ─── Email (Resend) ──────────────────────────────────────────
RESEND_API_KEY=re_xxxxx
RESEND_FROM_EMAIL=From the Trunk <hello@fromthetrunk.shop>

# ─── Cron Jobs ────────────────────────────────────────────────
# Shared secret for authenticating cron endpoints.
# Used by /api/v2/cron/release-reservations (every 10 min via Vercel Cron).
CRON_SECRET=generate-a-random-secret-for-cron

# ─── Admin API ────────────────────────────────────────────────
# Secret for admin-only API endpoints (order status updates, etc.)
ADMIN_API_SECRET=generate-a-random-admin-secret

# ─── ElectricSQL ───────────────────────────────────────────────
# Base URL of your Electric shape service (optional fallback to polling).
NEXT_PUBLIC_ELECTRIC_SHAPE_URL=

# ─── AI / Embeddings ───────────────────────────────────────────
OPENAI_API_KEY=
OPENAI_EMBEDDING_MODEL=text-embedding-3-small

#NEW KEY

# ─── Google Merchant API (Production only) ────────────────────
# Vercel OIDC → Google Workload Identity Federation. NO service-account key is
# used or stored anywhere: the running function's short-lived OIDC token is
# exchanged by Google's STS and impersonates the sync service account.
# Set these on the PRODUCTION environment only — the Workload Identity Provider
# trusts a single OIDC subject:
#   owner:<vercel-team>:project:<vercel-project>:environment:production
# Never expose any of these through a NEXT_PUBLIC_* variable.

# Complete downloaded external-account credential configuration, as one line of
# JSON. Its credential_source.file MUST be exactly /tmp/vercel-oidc-token, its
# token_url must be on sts.googleapis.com and its
# service_account_impersonation_url on iamcredentials.googleapis.com — the app
# validates all three and fails closed otherwise.
GOOGLE_WIF_CREDENTIALS_JSON={"type":"external_account", ...}

# Merchant Center account ID (digits only).
GOOGLE_MERCHANT_ACCOUNT_ID=
# Merchant API data source — reserved for the later product synchronisation.
GOOGLE_MERCHANT_DATA_SOURCE_ID=
GOOGLE_MERCHANT_DATA_SOURCE_NAME=accounts/<account-id>/dataSources/<data-source-id>
# Google account email recorded as the API developer contact.
GOOGLE_MERCHANT_DEVELOPER_EMAIL=

# Kill switch for POST /api/v2/integrations/google-merchant/register.
# The endpoint 404s unless this is the exact string "true". Set it to "true"
# only for the one-time registerGcp call, then unset it again.
GOOGLE_MERCHANT_REGISTRATION_ENABLED=false

# Kill switch for POST /api/v2/integrations/google-merchant/products/test-insert
# — the SINGLE controlled product insertion (one known product id, one
# confirmation phrase). Not a catalogue sync. The endpoint 404s unless this is
# the exact string "true"; set it to "true" only for that one insertion, then
# set it back to "false".
GOOGLE_MERCHANT_TEST_INSERT_ENABLED=false

# Kill switch for POST .../google-merchant/catalogue-backfill/apply — the
# controlled backfill of catalogue-level Merchant attributes (gender, age group,
# saree size). The preview endpoint needs no switch because it never writes.
# Apply 404s unless this is the exact string "true"; set it to "true" only for
# the backfill run, then set it back to "false".
GOOGLE_MERCHANT_CATALOGUE_BACKFILL_ENABLED=false

# Kill switch for POST .../google-merchant/catalogue-sync/apply — the controlled
# small-batch catalogue synchronisation (at most 5 products per invocation).
# The preview and status endpoints need no switch because they only read.
# Apply 404s unless this is the exact string "true"; set it to "true" for a
# batch, then set it back to "false".
GOOGLE_MERCHANT_CATALOGUE_SYNC_ENABLED=false

# Kill switch for POST .../google-merchant/image-metadata/apply — the bounded
# backfill that probes existing media and fills width/height/filesize/mimeType.
# The preview endpoint needs no switch because it only reads. Apply 404s unless
# this is the exact string "true"; set it to "true" for the paged run, then set
# it back to "false". It writes ONLY machine-derived media metadata — never url,
# key, filename, alt, product data, stock or price.
GOOGLE_MERCHANT_IMAGE_METADATA_BACKFILL_ENABLED=false

# Kill switch for the AUTOMATIC Google Merchant inventory reconciliation cron
# (GET /api/v2/cron/reconcile-google-merchant-inventory, every minute).
# Deliberately SEPARATE from GOOGLE_MERCHANT_CATALOGUE_SYNC_ENABLED: that one
# gates the manual bootstrap endpoints and stays "false" in normal production,
# while this one is the switch that stays "true" once the rollout is complete.
# When false the cron still answers 200 and reports what it WOULD do, but
# performs zero Google writes. The worker writes ONLY to Google — never to Neon.
GOOGLE_MERCHANT_INVENTORY_SYNC_ENABLED=false
